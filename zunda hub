-- Fly Logic
local function startFlying()
    if flying then return end
    flying = true

    local character = player.Character or player.CharacterAdded:Wait()
    local hrp = character:WaitForChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")

    -- Disable fall animation
    if humanoid then
        for _, track in pairs(humanoid:GetPlayingAnimationTracks()) do
            if track.Name:lower():find("fall") then
                track:Stop()
            end
        end
    end

    -- Velocity setup
    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bodyVelocity.Velocity = Vector3.zero
    bodyVelocity.P = 1e4
    bodyVelocity.Parent = hrp

    RunService:BindToRenderStep("CameraFly", Enum.RenderPriority.Character.Value + 1, function()
        if not flying or not hrp then return end
        local cam = workspace.CurrentCamera
        local direction = cam.CFrame.LookVector

        bodyVelocity.Velocity = direction * 50

        -- Rotate player to face movement direction
        hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + direction)
    end)
end

-- Stop Flying
local function stopFlying()
    flying = false
    RunService:UnbindFromRenderStep("CameraFly")
    if bodyVelocity then
        bodyVelocity:Destroy()
        bodyVelocity = nil
    end
end

-- Button Actions
flyButton.MouseButton1Click:Connect(startFlying)
stopButton.MouseButton1Click:Connect(stopFlying)

-- Update Scrolling
local function updateScrolling()
    -- Check if there are any buttons in the scroll frame
    if #scrollFrame:GetChildren() <= 1 then -- Only the credits text is left
        scrollFrame.CanvasSize = UDim2.new(0, 0, 0, 0)  -- Remove scroll area
        scrollFrame.ScrollBarThickness = 0  -- Disable scrollbar
    else
        scrollFrame.CanvasSize = UDim2.new(0, 0, 0, 1000)  -- Default canvas size
        scrollFrame.ScrollBarThickness = 8  -- Enable scrollbar
    end
end

-- Call this function to check if scrolling is needed
updateScrolling()
